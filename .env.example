SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-rotated-service-role-key

# Only required by local demo-user maintenance scripts.
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=replace-with-a-local-secret

# Optional overrides for scripts/set-pass-user.mjs.
TARGET_USER_EMAIL=
TARGET_USER_PASSWORD=

# Server-only AES-256-GCM key for IPTV credentials at rest (32+ hex chars).
# Generate with: openssl rand -hex 32
IPTV_ENCRYPTION_KEY=

# HMAC key for signing/sealing proxied HLS relay tokens (separate from the above).
# Generate with: openssl rand -hex 32
IPTV_PROXY_SIGNING_KEY=

# LiveKit (voice chat). Create a project at https://cloud.livekit.io to get
# these. LIVEKIT_URL is the wss:// or https:// host. If unset, voice chat is
# disabled and the UI surfaces a clear "not configured" error.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
IPTV_DEBUG_TIMING=false
IPTV_UPSTREAM_HEADERS_TIMEOUT_MS=30000
IPTV_UPSTREAM_IDLE_TIMEOUT_MS=45000
IPTV_SEGMENT_MAX_ATTEMPTS=2
IPTV_SEGMENT_CACHE_TTL_MS=20000
# Per-item / total segment cache limits. The app enforces 50 MiB / 500 MiB
# floors regardless (see src/lib/iptv-segment-cache-config.ts), so HD/4K
# segments are never rejected as "too large". Raise these only if you have RAM.
IPTV_SEGMENT_CACHE_ITEM_MAX_BYTES=52428800
IPTV_SEGMENT_CACHE_TOTAL_MAX_BYTES=524288000
